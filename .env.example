# cp .env.example .env and fill in. .env is gitignored.
OLLAMA_API_KEY=
TAVILY_API_KEY=

# live  — always call out, record to cache
# auto  — read-through cache; miss -> call + record.  DEV DEFAULT
# replay— cache only, hard error on miss.             DEMO DEFAULT
RESEARCH_MODE=auto

# Graph-RAG workspaces (optional; absent => feature disabled)
# SUPABASE_DB_URL=postgresql://user:pass@host:5432/postgres
# SUPABASE_DB_DIRECT_URL=   # optional: direct (non-pooler) URL for migrations
# EMBED_MODEL=embeddinggemma
# EMBED_DIM=768

# Copy to .env and fill in:  cp .env.example .env
# .env is git-ignored. Never commit real keys.

# ── Required ───────────────────────────────────────────────────────────────
# Ollama Cloud key: runs the chat models and the Ollama web-search lane.
# Get one at https://ollama.com/settings/keys
OLLAMA_API_KEY=

# ── Recommended ────────────────────────────────────────────────────────────
# Tavily adds a second web-search lane (used in pro and deep modes).
# Free tier at https://app.tavily.com
TAVILY_API_KEY=

# ── Cache behaviour ────────────────────────────────────────────────────────
# live   — always call providers, nothing cached (recommended for testing)
# auto   — reuse identical past calls from data/cache.sqlite, record new ones
# replay — cache only; fails on anything not already recorded
RESEARCH_MODE=live

# ── Optional: bring-your-own-key providers ─────────────────────────────────
# Lets you route any stage to groq/<model>, openrouter/<model> or google/<model>
# by setting e.g. VERIFIER_MODEL=groq/llama-3.3-70b-versatile
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=

# ── Optional: per-stage model overrides (defaults shown) ───────────────────
# PLANNER_MODEL=kimi-k2.6:cloud
# SUBAGENT_MODEL=mistral-large-3:675b:cloud
# CLAIMS_MODEL=kimi-k2.6:cloud
# VERIFIER_MODEL=kimi-k2.6:cloud
# REWRITER_MODEL=qwen3.5:397b:cloud
# LEAD_MODEL=mistral-large-3:675b:cloud
# REPORTER_MODEL=kimi-k2.7-code:cloud
# ROUTER_MODEL=kimi-k2.6:cloud
# DOER_MODEL=kimi-k2.7-code:cloud

# ── Optional: workspaces (research over your own documents) ────────────────
# Leave unset to run web-only. Needs Postgres with the pgvector extension
# (e.g. Supabase) and a local Ollama daemon for embeddings.
# SUPABASE_DB_URL=postgresql://user:password@host:5432/postgres
# SUPABASE_DB_DIRECT_URL=postgresql://user:password@host:5432/postgres
# EMBED_MODEL=embeddinggemma
# EMBED_DIM=768
# OLLAMA_URL=http://127.0.0.1:11434

# ── Optional: tuning ───────────────────────────────────────────────────────
# OLLAMA_MAX_INFLIGHT=3   # raise only on a paid Ollama tier
# SEM_VERIFY=4
